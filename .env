# ============================================================
# openai-edge-tts 环境变量配置文件
# 使用：cp .env.example .env，然后按需修改下面的配置
# ============================================================

# 鉴权密钥（必填）：调用接口时使用 Authorization: Bearer <此密钥>
# 请改成自己的随机字符串，不要使用默认值
API_KEY=sk-please-change-me

# 对外暴露的模型 ID 列表：逗号分隔
# 这些只是别名，实际都走同一个 edge-tts 合成引擎
# 只保留一个：tts-1
# 保留三个：tts-1,tts-1-hd,gpt-4o-mini-tts
TTS_MODELS=tts-1

# 对外暴露的宿主机端口（容器内部固定为 5050）
PORT=5050

# 默认音色：OpenAI 别名（alloy/echo/nova 等）或任意 Edge 音色名
# 常用示例：zh-CN-XiaoxiaoNeural、zh-CN-YunxiNeural、en-US-AvaNeural
DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# 默认输出格式：mp3 / wav / opus / aac / flac / pcm
DEFAULT_RESPONSE_FORMAT=mp3

# 默认语速：范围 0.25 ~ 4.0
DEFAULT_SPEED=1.0

# 默认语言：用于 /v1/voices 音色列表过滤
DEFAULT_LANGUAGE=zh-CN

# 是否强制鉴权：True=必须带 API_KEY，False=允许匿名调用
REQUIRE_API_KEY=True

# 是否关闭文本清洗：True=关闭 Markdown/emoji 清洗，False=保留清洗
REMOVE_FILTER=False

# 是否启用扩展兼容端点（ElevenLabs / Azure）
EXPAND_API=True

# 是否输出详细错误日志（排障时建议 True）
DETAILED_ERROR_LOGGING=True

# ------------------------------------------------------------
# 重试（针对微软侧瞬态失败：NoAudioReceived / 403 / 超时）
# ------------------------------------------------------------
# 每次合成的重试次数
TTS_RETRY_ATTEMPTS=3

# 退避基数（秒），指数增长：1s -> 2s -> 4s（含抖动）
TTS_RETRY_BASE_DELAY=1.0

# 音色列表内存缓存时长（秒）
TTS_VOICES_CACHE_TTL=300

# ------------------------------------------------------------
# 限流 / 有界队列 / 熔断
# ------------------------------------------------------------
# 每秒允许的合成请求数：0 = 不限速
TTS_RATE_LIMIT=1

# 令牌桶突发容量：允许瞬时多放几个请求
TTS_RATE_BURST=2

# 最多排队等待的请求数：0 = 不允许排队，满了直接返回 429
TTS_MAX_QUEUE=10

# 排队等待令牌的最长秒数：超时返回 429
TTS_QUEUE_TIMEOUT=30

# 连续失败多少次后熔断：0 = 关闭熔断
TTS_BREAKER_THRESHOLD=5

# 熔断后冷却秒数：期间直接返回 503，不再请求微软
TTS_BREAKER_COOLDOWN=60

# ------------------------------------------------------------
# 临时文件清理
# ------------------------------------------------------------
# 运行期清理周期（秒）：0 = 只在启动时清理一次
TTS_TEMP_CLEANUP_INTERVAL=600

# 只清理超过该年龄（秒）的临时文件
TTS_TEMP_MAX_AGE=3600
